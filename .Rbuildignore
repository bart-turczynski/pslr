# R build/dev artifacts
^LICENSE\.md$
^.*\.Rproj$
^\.Rproj\.user$
^\.Rhistory$
^\.RData$
^\.Ruserdata$
^.*\.Rcheck$
^.*\.tar\.gz$
^\.lintr$
^air\.toml$
^cran-comments\.md$
^CRAN-SUBMISSION$
^doc$
^Meta$
# Shared scaffold layer: everything below is dev tooling, not package content,
# and would otherwise trip "non-standard files/directories" in R CMD check.
^\.gitlab-ci\.yml$
# CI's cached R_LIBS_USER (see .gitlab-ci.yml). Once the Rprofile.site append
# there actually works, packages install into $CI_PROJECT_DIR/.rlib -- inside
# the package source, since GitLab can only cache paths under
# $CI_PROJECT_DIR -- and R CMD check flags it: "checking for hidden files and
# directories ... NOTE" plus a non-portable-path NOTE on what is inside it,
# which error_on = "warning" does not catch but a reviewer would.
^\.rlib$
^\.github$
^\.editorconfig$
^\.env$
^\.env\.example$
^\.gitattributes$
^\.gitignore$
^\.pre-commit-config\.yaml$
^\.verify-stamp$
^\.fp$
^\.claude$
^\.fossa$
^\.fossa\.yml$
^\.mailmap$
^FP_CLAUDE\.md$
^FP_AGENTS\.md$
^_scratch$
^tmp$
^bench$
^data-raw$
^docs$
^site$
^_pkgdown\.yml$
^CLAUDE\.md$
^AGENTS\.md$
^CONTRIBUTING\.md$
^CODE_OF_CONDUCT\.md$
^SECURITY\.md$
^CITATION\.cff$
^codemeta\.json$
^\.zenodo\.json$
^README\.Rmd$
^README\.html$
^\.DS_Store$
^ACKNOWLEDGMENTS\.md$
^\.bestpractices\.json$
# The citation gate ported from seor (design/adr/0002 there). Not part
# of the installable package; without this, --as-cran reports it as a
# non-standard top-level directory.
^scripts$
